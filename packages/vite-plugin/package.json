{
    "name": "@asset-shield/vite-plugin",
    "version": "0.2.0",
    "description": "Vite build plugin for AssetShield: deterministic filename masking, the protected-asset registry and legend, and optional obfuscation of application JS chunks. Vendoring-safe; CSS never obfuscated.",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "npm run build && node e2e/build.smoke.mjs"
    },
    "keywords": [
        "vite",
        "laravel",
        "assets",
        "security",
        "obfuscation",
        "plugin"
    ],
    "license": "MIT",
    "peerDependencies": {
        "vite": ">=5.0.0",
        "javascript-obfuscator": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "javascript-obfuscator": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^22.20.2",
        "javascript-obfuscator": "^5.7.0",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vite": "^6.0.0",
        "vitest": "^3.0.0"
    },
    "engines": {
        "node": ">=18"
    },
    "allowScripts": {
        "esbuild@0.27.7": true,
        "esbuild@0.25.12": true
    }
}
